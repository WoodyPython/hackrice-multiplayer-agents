# Copy to .env and fill in. Never commit .env.
# Server-only values (design section 5.3). The browser receives none of these
# except PUBLIC_APP_URL and the Supabase publishable key.

# --- Database ---
# Local development (docker compose up -d db):
DATABASE_URL=postgresql://app:app@localhost:54322/app
# Hosted Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the session pooler (port 5432) connection string, not the transaction
# pooler (6543): migrations and advisory locks need session-level state.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# Separate database used by `npm test`. Wiped and re-migrated per run.
TEST_DATABASE_URL=postgresql://app:app@localhost:54322/app_test

# --- Supabase (Role B: B04 storage, B06 realtime) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback; prefer SUPABASE_SECRET_KEY for new deployments.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable/anon key. This one IS shipped to the browser. It is designed to be
# public: it identifies the project and carries no authority on its own.
#
# REQUIRED FOR SIGN-IN. The browser uses this key for username/password sign-in,
# and the server uses it to verify the resulting access token. Account creation
# also requires the server-only secret key above so new username identities can
# be confirmed immediately without an email step.
SUPABASE_PUBLISHABLE_KEY=
# Storage bucket for reference materials. Create it PRIVATE: object access goes
# through the API, which scopes by workspace (section 11.4). Until this is set,
# materials are stored on local disk under GIT_DATA_ROOT/materials.
SUPABASE_STORAGE_BUCKET=materials

# --- Gemini (Role C) ---
# ENABLE BILLING on the project that issued this key. The free tier allows 20
# generateContent requests PER DAY, per project, per model
# (quotaId GenerateRequestsPerDayPerProjectPerModel-FreeTier). One run spends
# 6-8 worker requests, so a free key funds two or three runs a day and then
# every writer fails without producing a file. The orchestrator keeps working,
# because it is a different model with its own 20 and needs only one request —
# which is why this looks like "subagents cannot write files".
GEMINI_API_KEY=
# Google retires model IDs. gemini-2.5-pro/flash now answer 404 for new keys.
# Both tiers are Flash on purpose: a free-tier key has `limit: 0` quota for the
# Pro models, so an orchestrator routed to one fails every Start with a 429.
# `npm run gemini:smoke --workspace @app/server` lists what your key can reach,
# and any model set here also needs an entry in MODEL_PROFILES.
ORCHESTRATOR_MODEL=gemini-3.8-flash
WORKER_MODEL=gemini-3.6-flash

# --- Git runtime (Role D) ---
GIT_DATA_ROOT=./data

# --- Accounts (browser) ---
# Vite only exposes variables prefixed VITE_ to the bundle, so the two public
# Supabase values are repeated here for the frontend. Use the SAME values as
# above. Never add VITE_ to SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY:
# that would publish a server credential to every visitor.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Public ---
PUBLIC_APP_URL=http://localhost:5173
# On Render, omit PUBLIC_APP_URL to use RENDER_EXTERNAL_URL automatically.
PORT=3000
