    "dotenv": "^16.4.7",
    "fastify": "^5.12.4",
    "kysely": "^0.29.5",
    "pg": "^8.13.1",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
