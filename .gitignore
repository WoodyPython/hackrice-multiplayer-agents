node_modules/
dist/
build/
*.tsbuildinfo
coverage/

# Secrets: never commit. .env.example is the template.
.env
.env.*
!.env.example

# Local Git data root used by Role D (repos/worktrees). Anchored: an unanchored
# `data/` matches at any depth, which would also swallow .claude/skills/*/data.
/data/
/local-tasks/

# Local agent tooling. Teammates on Codex bring their own skills, so this stays
# a personal working aid rather than a repository-wide one.
/.claude/

.DS_Store
*.log

# Editors
.idea/
*.swp

# OS cruft
Thumbs.db
desktop.ini

# Test/tool caches
.vitest/
.vite/
__pycache__/
.npm-cache/
